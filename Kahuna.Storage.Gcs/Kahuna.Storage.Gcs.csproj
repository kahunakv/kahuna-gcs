<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kahuna.Storage.Gcs</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- The Kahuna server loads this assembly as an extension assembly, so its output carries the
         .deps.json a plugin load needs. The server reads its own runtimeconfig, never the extension's, so
         the package and the bundle carry none. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Kahuna.Storage.Gcs</PackageId>
    <Version>1.15.0</Version>
    <Authors>Andres Gutierrez</Authors>
    <Company>Andres Gutierrez</Company>
    <Description>Google Cloud Storage backup target for Kahuna: stores point-in-time-recovery manifests and backup artifacts in a GCS bucket.</Description>
    <PackageDescription>Google Cloud Storage backup target for Kahuna: stores point-in-time-recovery manifests and backup artifacts in a GCS bucket.</PackageDescription>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kahunakv/kahuna-gcs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kahunakv/kahuna-gcs</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>kahuna;backup;pitr;google cloud storage;gcs;object storage</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Storage.V1" Version="4.15.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <!--
    Kahuna.Core carries the backup storage contracts this package implements. 1.16.2 is the first
    release whose IBackupStorageProvider the server loads from an extension assembly. Tracks the
    latest Kahuna release; CI builds and tests against whatever version is pinned here.

    This project makes two products, and they need different things from this reference:
      - The NuGet package, for a host that embeds Kahuna. It must declare Kahuna.Core as a full
        dependency, or a host that references only this package compiles and then fails at run time
        because Kahuna.Core.dll is not copied.
      - The extension bundle, for the server (dotnet publish -p:ExtensionBundle=true). The server
        always supplies Kahuna.Core and everything under it (Kommander, Grpc, the RocksDB and SQLite
        natives), so the bundle must not carry copies of them. Excluding the runtime and native assets
        here also excludes them from every package reached only through Kahuna.Core.
    NuGet reads the dependency list from the restore output, so the two cannot share one restore:
    scripts/publish-bundle.sh restores and publishes with the property set.
  -->
  <ItemGroup>
    <PackageReference Include="Kahuna.Core" Version="1.16.2">
      <ExcludeAssets Condition="'$(ExtensionBundle)' == 'true'">runtime;native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    The package also carries the extension bundle, under tools/kahuna-extension/, so a server node
    installs the target from NuGet: download the package, extract that folder, and give the server the
    DLL there as its extension assembly. NuGet treats nothing under tools/ as a reference, so an
    embedding host gets lib/ only. (A DLL outside lib/ anywhere else draws warning NU5100.)

    The pack takes the bundle from ExtensionBundleDir, the output of scripts/publish-bundle.sh, as an
    absolute path (MSBuild resolves a relative one against this project folder). It refuses a folder
    that would ship a package the server cannot use: no bundle, a plain publish that still carries the
    server's own assemblies, or a bundle built for another version.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeExtensionBundle</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="IncludeExtensionBundle">
    <PropertyGroup>
      <_BundleDir Condition="'$(ExtensionBundleDir)' != ''">$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$(ExtensionBundleDir)'))'))</_BundleDir>
      <_BundleDll>$(_BundleDir)$(AssemblyName).dll</_BundleDll>
      <_BundleDeps>$(_BundleDir)$(AssemblyName).deps.json</_BundleDeps>
    </PropertyGroup>

    <Error Condition="'$(ExtensionBundleDir)' == ''"
           Text="The package carries the extension bundle. Run scripts/publish-bundle.sh and pass its output folder with -p:ExtensionBundleDir=..., or pack with scripts/set-version.sh, which does both." />
    <Error Condition="!Exists('$(_BundleDll)') Or !Exists('$(_BundleDeps)')"
           Text="ExtensionBundleDir '$(_BundleDir)' has no $(AssemblyName).dll and $(AssemblyName).deps.json. Use the output of scripts/publish-bundle.sh." />
    <Error Condition="$([System.IO.File]::ReadAllText('$(_BundleDeps)').Contains('&quot;Kahuna.Core/'))"
           Text="ExtensionBundleDir '$(_BundleDir)' carries Kahuna.Core. It is a plain dotnet publish, not the trimmed bundle. Use the output of scripts/publish-bundle.sh." />

    <GetAssemblyIdentity AssemblyFiles="$(_BundleDll);@(IntermediateAssembly->'%(FullPath)')">
      <Output TaskParameter="Assemblies" ItemName="_BundleIdentity" />
    </GetAssemblyIdentity>

    <PropertyGroup>
      <_BundleVersions>@(_BundleIdentity->'%(Version)'->Distinct())</_BundleVersions>
    </PropertyGroup>

    <Error Condition="$(_BundleVersions.Contains(';'))"
           Text="ExtensionBundleDir '$(_BundleDir)' holds $(AssemblyName) of another version than this pack ($(_BundleVersions)). Publish the bundle again." />

    <ItemGroup>
      <_BundleFile Include="$(_BundleDir)**/*" />
      <TfmSpecificPackageFile Include="@(_BundleFile)" PackagePath="tools/kahuna-extension/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Kahuna.Storage.Gcs.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
